# Copy to .env. docker compose reads it; for `python manage.py` / `pytest` on the
# host, export these in your shell.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is off.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Login + sign-up attempts per client IP.
AUTH_THROTTLE_RATE=20/min
POSTGRES_DB=mizan
POSTGRES_USER=mizan
POSTGRES_PASSWORD=mizan
POSTGRES_HOST=localhost
# Change if a local Postgres already uses 5432 (compose maps the container here).
POSTGRES_PORT=5432
API_PORT=8000
# Seconds to keep DB connections open. Only with a fixed worker pool
# (e.g. gunicorn); keep 0 for the dev server.
DJANGO_CONN_MAX_AGE=0

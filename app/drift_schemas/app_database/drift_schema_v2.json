          "sql": "CREATE TABLE IF NOT EXISTS \"expenses\" (\"version\" INTEGER NOT NULL DEFAULT 0, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"updated_by\" TEXT NULL, \"server_seq\" INTEGER NULL, \"id\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL, \"category_id\" TEXT NOT NULL, \"date\" TEXT NOT NULL, \"note\" TEXT NULL, \"source\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"

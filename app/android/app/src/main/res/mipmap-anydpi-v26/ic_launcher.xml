<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon on Android 8+ (adaptive: the launcher crops it to a
     circle, squircle, etc.). The layers are vectors redrawn from the icon
     artwork (ADR 0021). Android 7 uses mipmap-*/ic_launcher.png, cut from
     the artwork itself. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Android 13+ themed icons tint this one-colour layer. -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
